# Локальный стенд. В проде эти значения приходят из secret-хранилища (Vault / Secrets Manager),
# а не из файла в репозитории. Compose не поднимется, если переменные не заданы.
POSTGRES_PASSWORD=сгенерируйте-случайный
ORBITA_DB_PASSWORD=сгенерируйте-случайный
ORBITA_REDIS_PASSWORD=сгенерируйте-случайный

# Ключи приложения
JWT_SECRET=минимум-32-символа-случайных
TOKEN_ENCRYPTION_KEY=32-байта-в-base64

# Медиа-конвейер (ADR 0023, этап B)
# Подпись публичных ссылок: без неё карточки не уходят в каналы (воркер вернёт media_unavailable)
MEDIA_URL_SECRET=минимум-8-символов-случайных
# Внешний адрес API — из него собираются ссылки для Telegram/VK/MAX
MEDIA_PUBLIC_BASE=https://api.posiz.ru
# spool — каталог на общем томе API и воркера, s3 — S3/MinIO (нужен boto3 + бакет)
MEDIA_STORAGE=spool
MEDIA_SPOOL_DIR=/var/lib/posiz/media
# MEDIA_S3_BUCKET=posiz-media
# MEDIA_S3_ENDPOINT=http://minio:9000
# MEDIA_S3_REGION=ru-central1
# Явный путь к растеризатору: rsvg-convert или Chromium (автопоиск непредсказуем в контейнере)
# MEDIA_RASTER_BIN=/usr/bin/rsvg-convert
# Срок жизни артефактов; уборка — cron воркера в 04:20
MEDIA_TTL_DAYS=14
# Озвучка роликов: Yandex SpeechKit (рубли, без VPN). Без ключа работают mock/file,
# а провайдер yandex честно отвечает, что озвучка недоступна
# YANDEX_TTS_API_KEY=ключ-сервисного-аккаунта
# YANDEX_TTS_FOLDER_ID=b1g...
# Кинематографичная озвучка: ElevenLabs (Multilingual v2: интонации и паузы на русском).
# voice_id — идентификатор голоса из библиотеки; Adam/George/Callum — только названия
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # Turbo/Flash быстрее, но теряют подачу
# SteosVoice: русская фонетика и ударения в топонимах/именах
# STEOSVOICE_TOKEN=
# STEOSVOICE_VOICE=
# STEOSVOICE_API_URL=https://api.steosvoice.com/api/v1/synthesis
# Свой TTS-сервер (Fish Speech / F5-TTS / Piper): self-hosted, клиенту сервиса не предлагается
# MEDIA_LOCAL_TTS_URL=http://127.0.0.1:8123/tts
# Подача по умолчанию: neutral | cinematic-baritone | documentary | energetic
# MEDIA_TTS_PERFORMANCE=neutral
# Пакеты правил маркировки рынка (JSON): добавляют рынки без правки кода.
# Формат: {"kz-ad": {"title": "…", "labels": {"ru": "Жарнама"}, "age_values": [0,12,16,18], …}}
MEDIA_COMPLIANCE_PACKS=
# Лимиты ролика (переопределяют значения по умолчанию без релиза)
# MEDIA_REEL_MAX_DURATION=180   # 60 — Shorts, 180 — длинные Shorts, рендер дороже
# MEDIA_REEL_MAX_SCENES=6
# MEDIA_REEL_MIN_DURATION=4
# MEDIA_REEL_MAX_FRAMES=3000     # предохранитель рендер-ноды
# Тариф TTS-провайдера: смета следует за ним, а не за датой релиза
# MEDIA_TTS_YANDEX_RUB_PER_1000=1.342
# MEDIA_TTS_ELEVENLABS_RUB_PER_1000=1.76
# MEDIA_TTS_STEOSVOICE_RUB_PER_1000=0.3
# Статьи: иллюстрации. Без ключа доступна только своя графика (brand-card) — и это видно
# в GET /api/v1/articles/summary, а не подменяется случайной картинкой.
# Ключ провайдера иллюстраций и адрес генератора: статья соберётся и без них — тогда
# иллюстрацию рисует своя графика (brand-card), а причина отката видна в спеке.
# MEDIA_IMAGE_PROVIDER_KEY=
# MEDIA_IMAGE_PROVIDER_URL=
# MEDIA_STOCK_KEY=
# MEDIA_STOCK_URL=
# Ссылки между статьями: порог близости и лимит ссылок; срок ревью вечнозелёных статей.
# ARTICLE_LINK_MIN_SCORE=0.14
# ARTICLE_MAX_LINKS=4
# ARTICLE_REVIEW_DAYS=180
# A/B заголовка: минимум показов на вариант и порог значимости (двухсторонний z-тест).
# ARTICLE_AB_MIN_IMPRESSIONS=300
# ARTICLE_AB_ALPHA=0.05
# Перевод статьи: переводчик — данные (`translations`), здесь только выбор внешнего пути.
# ARTICLE_TRANSLATOR=manual
# Статьи: ниша — данные. Паки правил (политика темы) и шаблоны (токены вёрстки) подключаются
# файлами, без релиза; формат — словарь {"код": {...}}. ARTICLE_RULE_PACKS=config/rule-packs.json
# ARTICLE_TEMPLATES=config/templates.json
# Ролики 9:16: кодирование и проверка файла (в образе уже есть)
# MEDIA_FFMPEG_BIN=/usr/bin/ffmpeg
# MEDIA_FFPROBE_BIN=/usr/bin/ffprobe

APP_ENV=production
API_BIND=127.0.0.1:8000
# RBAC_DEMO_ROLES в production обязан быть выключен
RBAC_DEMO_ROLES=0
